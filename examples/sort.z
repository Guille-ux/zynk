#
# Example with sorting algorithms
#

# Insertion Sort Pseudocode (Wikipedia)
#i ← 1
#while i < length(A)
#    j ← i
#    while j > 0 and A[j-1] > A[j]
#        swap A[j] and A[j-1]
#        j ← j - 1
#    end while
#    i ← i + 1
#end while

fn insertionSort {
	let arr = $0
	let j
	for (let i=0;i<arr:len(arr);i=i+1) do
		j = i
		for (;j>0;) do
			if index(arr:data j-1)>index(arr:data j) then
				arr:swap(arr j j-1)
				j = j - 1
			else
				break
			fi
		done	
	done
}

let arr = Array()
arr:push(arr 10)
arr:push(arr 5)
arr:push(arr 15)

echo "Before Sort: "
echo arr:data

insertionSort(arr)

echo "After Sort: "
echo arr:data
