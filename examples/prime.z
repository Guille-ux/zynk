#
# This Example features a function that checks if a given number is
# prime or not
#

fn isPrime {
	let n = $0
	
	if n==2 then return 1 fi # 2 is a prime yk

	let i=2
	do {
		if (n%i)==0 then return i fi
		i = i + 1
	} while i < n # if i==n obviously n % i is going to be 0
	
	return 1
}

let num = float(input("Type a Number: "))
let res = isPrime(num)

if res==1 then
	echo "The number " + num + " is a prime number"
else
	echo "The number " + num + " is not a prime number"
	echo "It was divisible by " + res
fi

# Example Output:
# Type a Number: 2198738216412377
# The number 2198738216412377.000000 is not a prime number
# It was divisible by 455219.000000


