echo "Hola" + ", IDK"

class Coche {
	let marca = "Volkswagen"
	let modelo = "Golf Plus"
	fn info {
		let self = $0
		echo "Marca -> " + self:marca
		echo "Modelo -> " + self:modelo
	}
	fn crash {
		echo "CRASH"
	}
}

let my=Coche()
echo my
my:info(my)
my:crash()

echo "hum!"

let start = clock()

include("libs/net.so")

let socket = Net:socket()

let hostname = "www.google.com"

let ip = Net:getip(hostname)

let port = 80
let request = "GET / HTTP/1.1\r\nHost: www.google.com\r\nConnection: close\r\n\r\n"

Net:connect(socket ip port)
Net:send(socket request)

let text = "\n"
let new = "\0"
let end = 0
do {
	new = Net:recv(socket 1)
	echo new
	text = text + new
	end = len(text)
	#echo new
	if index(text end)=="\n" and index(text end-1) == "\r" and index(text end-2) == "\n" and index(text end-3)=="\r" then
		echo "CONNECTION ENDED"
		Net:close(socket)
		break
	fi
	if len(new) < 10 then
		break
	fi

} while 1

echo "Elapsed Time: " + (clock() - start)
