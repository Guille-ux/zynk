syntax "zynk" "\.zynk$" "\.z$" "\.zk$" "\.zn$"
header "^#!.*zynk"

# Palabras clave y control de flujo
color cyan "\b(let|fn|return|if|then|else|fi|class|echo|del|break|for|do|done|while)\b"
color green "\b(true|false)\b"

# Funciones nativas y tipos
color yellow "\b(min|max|push|pop|len|Array|input|include|import|index|read|write|system|clock|str|float|arg|ord|chr|getb|setb|newb|getenv|eval)\b"

# Números (enteros y decimales)
color magenta "\b[0-9]+(\.[0-9]+)?\b"

# Cadenas de texto
color red ""([^"]|\\")*""

# Nombres de clases (la palabra que sigue a 'class')
color brightmagenta "\bclass[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

# Comentarios
color blue "#.*$"


color brightblue "\b(fn)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)"

color brightmagenta "\b(class)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)"

color brightcyan "\b(let)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)"
